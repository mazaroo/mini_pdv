# Copie esse arquivo para .env e preencha com as credenciais do seu banco
# (o .env nunca é enviado pro GitHub — está no .gitignore).
#
# Localmente, se você não criar um .env, o projeto usa os valores padrão
# antigos (localhost / root / masterkey / pdv) automaticamente.
# Em produção (Railway, Render, etc.), defina essas variáveis no painel do
# serviço em vez de criar um arquivo .env.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=masterkey
DB_NAME=pdv
